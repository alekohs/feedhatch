# Maintainer: Alexander Kohkoinen Morin <alexander@alekoh.se>
pkgname=feedhatch
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-driven RSS reader in the terminal, with an optional background fetcher'
arch=('x86_64' 'aarch64')
url='https://github.com/alekohs/feedhatch'
license=('MIT')
makedepends=('go' 'git')
options=('!debug')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  export CGO_ENABLED=0 GOFLAGS='-trimpath -mod=readonly -modcacherw'
  go build -ldflags "-s -w -X main.version=$pkgver" -o feedhatch ./cmd/feedhatch
}

check() {
  cd "$pkgname"
  go test ./...
}

package() {
  cd "$pkgname"
  install -Dm755 feedhatch "$pkgdir/usr/bin/feedhatch"
  install -Dm644 packaging/linux/feedhatch.desktop "$pkgdir/usr/share/applications/feedhatch.desktop"
  install -Dm644 packaging/linux/feedhatch.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/feedhatch.svg"
  install -Dm644 packaging/linux/feedhatch.service "$pkgdir/usr/lib/systemd/user/feedhatch.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/feedhatch/LICENSE"
}
